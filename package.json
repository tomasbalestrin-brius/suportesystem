{
  "name": "suportesystem",
  "version": "1.0.0",
  "description": "Sistema de Suporte Inteligente com IA (Sofia GPT-4)",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tomasbalestrin-brius/suportesystem.git"
  },
  "scripts": {
    "dev": "cd frontend-platform && pnpm dev",
    "build": "cd frontend-platform && pnpm build",
    "start": "cd frontend-platform && pnpm start",
    "install:frontend": "cd frontend-platform && pnpm install",
    "clean": "cd frontend-platform && rm -rf .next node_modules && pnpm install",
    "type-check": "cd frontend-platform && pnpm type-check",
    "deploy": "vercel --prod"
  },
  "keywords": [
    "ai",
    "support",
    "customer-service",
    "chatbot",
    "gpt-4",
    "nextjs",
    "supabase",
    "tickets"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.25.0"
}
