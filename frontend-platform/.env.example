# ==================================================
# SISTEMA DE SUPORTE - Variáveis de Ambiente
# ==================================================
#
# Copie este arquivo para .env.local e preencha os valores
# cp .env.example .env.local
#

# --------------------------------------------------
# SUPABASE (OBRIGATÓRIO)
# --------------------------------------------------
# Como obter:
# 1. Acesse https://supabase.com e faça login
# 2. Crie um novo projeto ou acesse um existente
# 3. Vá em Project Settings > API
# 4. Copie a URL e as chaves abaixo

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (CUIDADO: Usar apenas em servidor, nunca expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# --------------------------------------------------
# OPENAI (OBRIGATÓRIO)
# --------------------------------------------------
# Como obter:
# 1. Acesse https://platform.openai.com
# 2. Faça login ou crie uma conta
# 3. Vá em API Keys
# 4. Clique em "Create new secret key"
# 5. Dê um nome (ex: "Sistema de Suporte")
# 6. Copie a chave (começa com sk-proj-...)
#
# IMPORTANTE: Você precisa ter créditos na conta OpenAI
# Adicione pelo menos $5 em Billing > Payment methods

OPENAI_API_KEY=sk-proj-...


# --------------------------------------------------
# APLICAÇÃO (Opcional mas recomendado)
# --------------------------------------------------

# URL da aplicação em produção (para emails, redirects, etc)
NEXT_PUBLIC_APP_URL=https://seudominio.com

# Ambiente (development, production)
NODE_ENV=development


# --------------------------------------------------
# INTEGRAÇÕES EXTERNAS (Opcional)
# --------------------------------------------------
# Descomente e configure se você tiver integrações

# Plataforma de Compras/Pagamentos (Hotmart, Stripe, etc)
# PURCHASE_PLATFORM_URL=https://api.plataforma-pagamentos.com
# PURCHASE_PLATFORM_API_KEY=sua_chave_api
# PURCHASE_PLATFORM_API_SECRET=seu_secret

# Área de Membros
# MEMBER_PLATFORM_URL=https://api.area-membros.com
# MEMBER_PLATFORM_API_KEY=sua_chave_api

# Email/Notificações (Resend, SendGrid, etc)
# RESEND_API_KEY=re_...
# NOTIFICATION_EMAIL_FROM=suporte@seudominio.com
# NOTIFICATION_EMAIL_TO=admin@seudominio.com

# AWS SES (se usar)
# EMAIL_PLATFORM_API_KEY=sua_chave_aws
# AWS_SES_REGION=us-east-1

# Hotmart Webhook (se usar)
# HOTMART_WEBHOOK_SECRET=seu_secret_hotmart
# HOTMART_API_TOKEN=seu_token_hotmart


# --------------------------------------------------
# MONITORAMENTO E ANALYTICS (Opcional)
# --------------------------------------------------

# Sentry (monitoramento de erros)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=...

# Vercel Analytics (automático se deploy no Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=...

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...


# --------------------------------------------------
# DESENVOLVIMENTO (Opcional)
# --------------------------------------------------

# Habilitar logs detalhados
# DEBUG=true

# Desabilitar telemetria do Next.js
# NEXT_TELEMETRY_DISABLED=1
